BOT_TOKEN=123456:ABC...
# Публичный HTTPS-адрес, где доступен сервер (ngrok, домен и т.п.)
WEBAPP_URL=https://your-domain.com
# Канал для миссии "подписаться" (бот должен быть админом канала), можно оставить пустым
CHANNEL_USERNAME=@your_channel
PORT=8000
# Админы: username без @ (через запятую) и/или числовые ID (надёжнее — узнать через /admin)
ADMIN_USERNAMES=
ADMIN_IDS=
# Журнал всех HTTP-запросов с IP-адресами (для отладки). По умолчанию выключен — меньше личных данных на сервере
ACCESS_LOG=0
# Оплата бустов в TON: кошелёк для приёма (можно задать и в админке) и ключ toncenter.com (необязательно)
BOTOHUB_TOKEN=
# ^ токен из @botohub (задания-спонсоры в Missions). Пусто — задания BotoHub выключены
TON_WALLET=
TONCENTER_API_KEY=
